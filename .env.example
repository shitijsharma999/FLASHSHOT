# Browser client (Vite — only VITE_* are exposed to the client)
VITE_APP_NAME=Flashshot
VITE_API_BASE_URL=http://localhost:8080
VITE_GAME_SERVER_WS_URL=ws://localhost:9090/ws

# Spring API server
API_SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL (api-server)
DATABASE_URL=jdbc:postgresql://localhost:5432/flashshot
DATABASE_USERNAME=flashshot
DATABASE_PASSWORD=flashshot_dev

# Redis (api-server)
REDIS_HOST=localhost
REDIS_PORT=6379

# Game server (Netty)
GAME_SERVER_HTTP_PORT=9091
GAME_SERVER_WS_PORT=9090
GAME_SERVER_WS_PATH=/ws
